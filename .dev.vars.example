# Copy this file to `.dev.vars` (gitignored) for local `wrangler pages dev` testing.
# In production, set these as encrypted environment variables in the Cloudflare
# Pages dashboard (Settings -> Environment variables) instead — never commit real values.

# Resend API key (https://resend.com/api-keys). Required to send any email.
RESEND_API_KEY=

# The business inbox that should receive new estimate requests.
# No default is set anywhere in the code — this must be configured.
LEAD_NOTIFICATION_EMAIL=

# The "from" address Resend sends as. Must be on a domain verified with Resend
# (https://resend.com/domains) or delivery will fail.
LEAD_FROM_EMAIL=

# Optional. If set, the server will verify a Cloudflare Turnstile token on
# submission. If left unset, Turnstile verification is skipped entirely
# (no frontend widget is wired up yet — see the final report for why).
TURNSTILE_SECRET_KEY=
